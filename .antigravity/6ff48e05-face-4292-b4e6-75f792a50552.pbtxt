          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"en\": \"A dialogue between the elemental and the refined. Our menu is a curated progression through the textures of the landscape, translated into architectural plates.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"id\": \"Dialog sublim antara yang purba dan yang luhur. Menu kami merupakan kemajuan tertib melintasi tekstur lansekap Batam, diterjemahkan menjadi piring-piring seni bercita rasa arsitektur.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"zh\": \"\344\270\200\345\271\225\345\234\250\347\262\227\347\262\235\345\216\237\350\264\250\344\270\216\347\273\206\350\205\273\347\203\271\351\245\252\350\211\272\346\234\257\344\271\213\351\227\264\347\232\204\351\273\230\345\245\221\350\260\203\350\247\243\343\200\202\345\245\242\345\215\216\350\217\234\345\215\225\345\246\202\345\220\214\344\270\200\351\246\226\345\234\260\347\220\206\344\272\244\345\223\215\350\257\227\357\274\214\345\260\206\344\270\207\347\211\251\350\202\214\347\220\206\350\275\254\345\214\226\344\270\272\350\210\214\345\260\226\344\270\212\347\232\204\347\253\213\344\275\223\346\236\204\346\210\220\343\200\202\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
