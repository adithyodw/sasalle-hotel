          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"phase1_title\": {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"en\": \"Phase I: Earth\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"id\": \"Tahap I: Tanah Subur\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"zh\": \"\347\254\254\344\270\200\347\272\252\357\274\232\351\207\215\345\234\237 (Earth)\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"phase1_desc\": {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"en\": \"Root textures. Smoked clay. Subterranean aromatics. A study in the permanence of the soil.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"id\": \"Tekstur umbi terpendam. Clay yang diasapi. Rempah tanah harum. Sebuah ulikan atas keabadian tanah liat.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"zh\": \"\347\224\237\346\240\271\345\235\227\350\214\216\343\200\202\347\206\217\347\203\247\347\262\230\345\234\237\345\276\256\345\260\230\343\200\202\345\271\275\346\232\227\345\234\260\345\272\225\350\212\263\351\246\231\347\211\251\343\200\202\350\277\231\346\230\257\344\270\200\345\234\272\345\257\271\346\260\270\346\201\222\345\244\247\345\234\260\346\267\261\345\244\204\344\271\213\345\205\273\345\210\206\344\270\216\345\234\237\345\243\244\351\205\270\347\242\261\345\272\246\347\232\204\347\240\224\347\251\266\343\200\202\""
