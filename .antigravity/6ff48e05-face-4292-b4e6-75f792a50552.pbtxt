        lines {
          text: "  \"spa_title\": {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"en\": \"The Architectural Stillness\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"id\": \"Suhu Keheningan Arsitektur\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"zh\": \"\346\260\264\344\271\213\346\256\277\345\240\202\347\232\204\345\256\201\351\235\231\345\233\236\345\223\215\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
