          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"id\": \"Tahap II: Besi Tempa\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"zh\": \"\347\254\254\344\272\214\347\272\252\357\274\232\347\206\224\351\207\221 (Metal)\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
