    replacement_chunks {
      target_content: "  return (\n    <div className=\"min-h-screen bg-[#EEEDF2] font-sans antialiased text-[#0B0D10]\">\n      {/* Editorial Luxury Header Top navbar */}\n      <Header\n        language={language}\n        setLanguage={setLanguage}\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        viewMode={viewMode}\n        setViewMode={setViewMode}\n      />\n\n      {/* Primary Workspace Space Adjuster */}\n      <main className=\"pt-28 pb-10 min-h-[calc(100vh-120px)] transition-all\">\n        {viewMode === \'mobile\' ? (\n          /* High Fidelity Mobile Simulation UI Frame */\n          <div className=\"px-4\">\n            <MobileDeviceFrame>\n              {activeTab === \'home\' && (\n                <GuestView\n                  language={language}\n                  activeTab=\"home\"\n                  activeBooking={activeBooking}\n                  onBookingComplete={handleBookingComplete}\n                  onOpenBookingWizard={handleOpenBookingWizard}\n                  selectedRoomForWizard={selectedRoomForWizard}\n                  onCloseBookingWizard={handleCloseBookingWizard}\n                  isWizardOpen={isWizardOpen}\n                />\n              )}\n              {activeTab === \'rooms\' && (\n                <GuestView\n                  language={language}\n                  activeTab=\"rooms\"\n                  activeBooking={activeBooking}\n                  onBookingComplete={handleBookingComplete}\n                  onOpenBookingWizard={handleOpenBookingWizard}\n                  selectedRoomForWizard={selectedRoomForWizard}\n                  onCloseBookingWizard={handleCloseBookingWizard}\n                  isWizardOpen={isWizardOpen}\n                />\n              )}\n              {activeTab === \'key\' && (\n                <div className=\"pt-4 px-4\">\n                  <DigitalKey activeBooking={activeBooking} language={language} />\n                </div>\n              )}\n              {activeTab === \'concierge\' && (\n                <div className=\"h-[730px] flex flex-col\">\n                  <ConciergeChat\n                    language={language}\n                    activeBooking={activeBooking}\n                    onUpdateBookingPrefs={handleUpdateBookingPrefs}\n                    onAddHousekeeping={handleAddHousekeeping}\n                    onAddDining={handleAddDining}\n                  />\n                </div>\n              )}\n              {activeTab === \'admin\' && (\n                <div className=\"p-4 bg-white/90 font-mono text-center text-xs space-y-4\">\n                  <span className=\"font-bold text-[#7A3A2E]\">BACKSTAGE NOT SUITED FOR SMARTPHONE PORTRAIT VIEW</span>\n                  <p className=\"text-stone-500\">Please switch view mode to [ DESKTOP ] using the switcher above.</p>\n                </div>\n              )}\n            </MobileDeviceFrame>\n\n            {/* Simulated iPhone Hardware Bottom Nav Button integration */}\n            <BottomNav activeTab={activeTab} setActiveTab={setActiveTab} language={language} />\n          </div>\n        ) : (\n          /* Desktop Luxury Web view (fully stretched, clean, spacious columns layout) */\n          <div className=\"max-w-7xl mx-auto px-4 sm:px-8\">\n            {activeTab === \'admin\' ? (\n              <AdminView\n                bookings={bookings}\n                housekeeping={housekeeping}\n                diningOrders={diningOrders}\n                logs={logs}\n                onToggleHousekeeping={handleToggleHousekeeping}\n                onToggleDining={handleToggleDining}\n                onCancelBooking={handleCancelBooking}\n              />\n            ) : activeTab === \'concierge\' ? (\n              <div className=\"max-w-2xl mx-auto bg-white border border-[#86736F]/40 p-4 md:p-8\">\n                <ConciergeChat\n                  language={language}\n                  activeBooking={activeBooking}\n                  onUpdateBookingPrefs={handleUpdateBookingPrefs}\n                  onAddHousekeeping={handleAddHousekeeping}\n                  onAddDining={handleAddDining}\n                />\n              </div>\n            ) : activeTab === \'key\' ? (\n              <div className=\"max-w-md mx-auto py-10\">\n                <DigitalKey activeBooking={activeBooking} language={language} />\n              </div>\n            ) : (\n              <GuestView\n                language={language}\n                activeTab={activeTab === \'rooms\' ? \'rooms\' : \'home\'}\n                activeBooking={activeBooking}\n                onBookingComplete={handleBookingComplete}\n                onOpenBookingWizard={handleOpenBookingWizard}\n                selectedRoomForWizard={selectedRoomForWizard}\n                onCloseBookingWizard={handleCloseBookingWizard}\n                isWizardOpen={isWizardOpen}\n              />\n            )}\n          </div>\n        )}\n      </main>\n\n      {/* Flat Desktop Footer Info Panel (only displays on desktop viewMode to avoid blocking device frame layout) */}\n      {viewMode === \'desktop\' && (\n        <footer className=\"bg-[#0B0D10] text-[#F5F1EA]/60 font-mono text-[11px] py-12 px-6 border-t border-[#86736F]/30 text-center space-y-3\">\n          <p className=\"tracking-widest text-[#B89B5E] font-black uppercase\">SASALLE Batam Island \342\200\242 Indonesia</p>\n          <p className=\"text-stone-500 max-w-lg mx-auto leading-relaxed\">\n            Quietly nestled along pristine tropical sandstone ridges. Crafted with material integrity, architectural stillness, and absolute presence.\n          </p>\n          <div className=\"pt-4 text-[9px] text-[#A7A7A7]/40 flex justify-center gap-4\">\n            <span>\302\251 MCMXXIV SASALLE RESORTS</span>\n            <span>\342\200\242</span>\n            <span>REST CONTROL ACTS SYNCHRONIZED</span>\n          </div>\n        </footer>\n      )}"
      replacement_content: "  return (\n    <div className=\"min-h-screen bg-[#F5F1EA] bg-dot-grid font-sans antialiased text-[#0B0D10] relative\">\n      {/* Editorial Luxury Header Top navbar */}\n      <Header\n        language={language}\n        setLanguage={setLanguage}\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        viewMode={viewMode}\n        setViewMode={setViewMode}\n      />\n\n      {/* Primary Workspace Space Adjuster */}\n      <main className=\"pt-28 pb-10 min-h-[calc(100vh-120px)] transition-all relative z-10\">\n        {viewMode === \'mobile\' ? (\n          /* High Fidelity Mobile Simulation UI Frame */\n          <div className=\"px-4\">\n            <MobileDeviceFrame>\n              {activeTab === \'home\' && (\n                <GuestView\n                  language={language}\n                  activeTab=\"home\"\n                  activeBooking={activeBooking}\n                  onBookingComplete={handleBookingComplete}\n                  onOpenBookingWizard={handleOpenBookingWizard}\n                  selectedRoomForWizard={selectedRoomForWizard}\n                  onCloseBookingWizard={handleCloseBookingWizard}\n                  isWizardOpen={isWizardOpen}\n                />\n              )}\n              {activeTab === \'rooms\' && (\n                <GuestView\n                  language={language}\n                  activeTab=\"rooms\"\n                  activeBooking={activeBooking}\n                  onBookingComplete={handleBookingComplete}\n                  onOpenBookingWizard={handleOpenBookingWizard}\n                  selectedRoomForWizard={selectedRoomForWizard}\n                  onCloseBookingWizard={handleCloseBookingWizard}\n                  isWizardOpen={isWizardOpen}\n                />\n              )}\n              {activeTab === \'key\' && (\n                <div className=\"pt-4 px-4\">\n                  <DigitalKey activeBooking={activeBooking} language={language} />\n                </div>\n              )}\n              {activeTab === \'concierge\' && (\n                <div className=\"h-[730px] flex flex-col\">\n                  <ConciergeChat\n                    language={language}\n                    activeBooking={activeBooking}\n                    onUpdateBookingPrefs={handleUpdateBookingPrefs}\n                    onAddHousekeeping={handleAddHousekeeping}\n                    onAddDining={handleAddDining}\n                  />\n                </div>\n              )}\n              {activeTab === \'admin\' && (\n                <div className=\"p-4 bg-white/95 font-mono text-center text-xs space-y-4 border border-[#0B0D10]/10\">\n                  <span className=\"font-bold text-[#7A3A2E]\">BACKSTAGE NOT SUITED FOR SMARTPHONE PORTRAIT VIEW</span>\n                  <p className=\"text-stone-500\">Please switch view mode to [ DESKTOP ] using the switcher above.</p>\n                </div>\n              )}\n            </MobileDeviceFrame>\n\n            {/* Simulated iPhone Hardware Bottom Nav Button integration */}\n            <BottomNav activeTab={activeTab} setActiveTab={setActiveTab} language={language} />\n          </div>\n        ) : (\n          /* Desktop Luxury Web view (fully stretched, clean, spacious columns layout) */\n          <div className=\"max-w-7xl mx-auto px-4 sm:px-8\">\n            {activeTab === \'admin\' ? (\n              <AdminView\n                bookings={bookings}\n                housekeeping={housekeeping}\n                diningOrders={diningOrders}\n                logs={logs}\n                onToggleHousekeeping={handleToggleHousekeeping}\n                onToggleDining={handleToggleDining}\n                onCancelBooking={handleCancelBooking}\n              />\n            ) : activeTab === \'concierge\' ? (\n              <div className=\"max-w-2xl mx-auto bg-white/90 backdrop-blur-md border border-[#0B0D10]/15 p-4 md:p-8 shadow-lg\">\n                <ConciergeChat\n                  language={language}\n                  activeBooking={activeBooking}\n                  onUpdateBookingPrefs={handleUpdateBookingPrefs}\n                  onAddHousekeeping={handleAddHousekeeping}\n                  onAddDining={handleAddDining}\n                />\n              </div>\n            ) : activeTab === \'key\' ? (\n              <div className=\"max-w-md mx-auto py-10\">\n                <DigitalKey activeBooking={activeBooking} language={language} />\n              </div>\n            ) : (\n              <GuestView\n                language={language}\n                activeTab={activeTab === \'rooms\' ? \'rooms\' : \'home\'}\n                activeBooking={activeBooking}\n                onBookingComplete={handleBookingComplete}\n                onOpenBookingWizard={handleOpenBookingWizard}\n                selectedRoomForWizard={selectedRoomForWizard}\n                onCloseBookingWizard={handleCloseBookingWizard}\n                isWizardOpen={isWizardOpen}\n              />\n            )}\n          </div>\n        )}\n      </main>\n\n      {/* Flat Desktop Footer Info Panel (only displays on desktop viewMode to avoid blocking device frame layout) */}\n      {viewMode === \'desktop\' && (\n        <footer className=\"border-t border-[#0B0D10]/10 px-12 py-8 flex flex-col md:flex-row justify-between items-center z-20 text-[#0B0D10]/60 font-sans text-[10px] uppercase tracking-[0.2em] gap-4 bg-[#F5F1EA]/80 backdrop-blur-sm\">\n          <div className=\"flex gap-8\">\n            <span className=\"font-bold text-[#0B0D10]\">Batam, Indonesia</span>\n            <span>+62 778 456 000</span>\n          </div>\n          <div className=\"text-center font-headline tracking-[0.1em] text-[#7A3A2E] text-xs\">\n            \302\251 SASALLE RESORTS \342\200\242 ARCHITECTURAL STILLNESS\n          </div>\n          <div className=\"flex gap-8 items-center\">\n            <span>Instagram</span>\n            <span>Journal</span>\n            <div className=\"flex gap-2 items-center\">\n              <div className=\"w-2 h-2 rounded-full bg-[#7A3A2E] animate-pulse\"></div>\n              <span className=\"text-[#0B0D10] font-bold\">Status: Open</span>\n            </div>\n          </div>\n        </footer>\n      )}"
