        }
        lines {
          text: "  \"spa_intro_quote\": {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"en\": \"\\\"Restoration through architectural silence.\\\"\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"id\": \"\\\"Pemulih jiwa melalui arsitektur yang hening.\\\"\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"zh\": \"\342\200\234\345\200\237\351\235\231\351\273\230\347\232\204\347\240\226\347\237\263\347\247\251\345\272\217\351\207\215\345\241\221\347\226\262\346\203\253\344\271\213\350\272\257\342\200\235\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"spa_intro_body\": {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"en\": \"Experience SASALLE\'s spa\342\200\224a museum of the senses. Here, we honor the permanence of stone, the warmth of clay, and the clarity of water. Every ritual is designed as a physical dialogue between the body and the space it inhabits.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"id\": \"Saksikan spa SASALLE\342\200\224museum panca indera yang agung. Kami menghayati keabadian batu, kehangatan lempung merah, serta kemurnian aliran air. Setiap ritual dirancang sebagai sebuah bahasa spiritual yang menyatukan raga Anda ke dalam dimensi arsitektural.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"zh\": \"\344\272\262\344\270\264\346\262\231\350\220\250\345\213\222\347\220\206\347\226\227\346\256\277\345\240\202\342\200\224\342\200\224\350\277\231\346\230\257\345\243\260\350\211\262\345\222\214\350\247\246\350\247\211\347\232\204\346\204\237\345\256\230\350\211\272\346\234\257\351\246\206\343\200\202\346\210\221\344\273\254\350\207\264\346\225\254\345\267\250\347\237\263\347\232\204\351\235\231\347\253\213\343\200\201\347\262\230\345\234\237\347\232\204\345\276\256\346\270\251\343\200\201\344\273\245\345\217\212\346\260\264\346\265\201\347\232\204\346\264\236\346\276\210\343\200\202\346\257\217\344\270\200\350\212\202\347\226\227\346\204\210\357\274\214\347\232\206\346\230\257\344\272\272\344\275\223\347\224\237\345\221\275\345\276\213\345\212\250\344\270\216\347\211\251\347\220\206\345\256\207\345\256\231\344\273\213\350\264\250\347\232\204\351\235\231\351\273\230\344\272\244\350\260\210\343\200\202\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
