        }
        lines {
          text: "  \"phase2_desc\": {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"en\": \"Conductive heat. Cold-pressed reduction. The precision of the blade meets the intensity of the flame.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"id\": \"Konduktivitas suhu tinggi. Reduksi perahan dingin. Ketajaman bilah pisau bertemu dengan amukan bara api.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"zh\": \"\344\274\240\345\257\274\351\253\230\347\203\255\343\200\202\345\206\267\346\246\250\347\272\257\347\262\271\346\265\270\350\206\217\343\200\202\351\224\213\345\210\251\351\222\242\345\210\203\347\232\204\350\247\204\346\225\264\357\274\214\344\270\216\347\206\212\347\206\212\351\223\270\347\202\211\347\204\260\347\201\253\345\234\250\346\227\266\351\227\264\345\210\273\345\272\246\351\207\214\347\232\204\344\272\244\345\223\215\343\200\202\""
