          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    \"en\": \"Architecture is more than form; it is a sensory dialogue between the earth\'s raw elements and the human spirit. At SASALLE, we curate stillness through stone and linen.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    \"id\": \"Arsitektur melampaui batas wujud fisik; ia adalah dialog yang menyentuh panca indera antara elemen bumi dan suksma manusia. Di SASALLE, kami membingkai sunyi lewat untaian batu dan kain linen.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
