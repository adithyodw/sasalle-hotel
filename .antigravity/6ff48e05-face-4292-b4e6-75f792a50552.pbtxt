  file_change {
    absolute_path_uri: "file:///src/components/GuestView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState } from \'react\';\nimport { Room, Booking, Language } from \'../types\';\nimport { ROOMS, DICTIONARY, INDONESIA_BOTANICALS } from \'../data\';\nimport { Calendar, Users, Clock, ArrowRight, ShieldCheck, Heart, Award, Sparkles } from \'lucide-react\';\nimport BookingWizard from \'./BookingWizard\';\n\ninterface GuestViewProps {\n  language: Language;\n  activeTab: \'home\' | \'rooms\' | \'key\' | \'concierge\';\n  activeBooking: Booking | null;\n  onBookingComplete: (booking: Booking) => void;\n  onOpenBookingWizard: (room: Room) => void;\n  selectedRoomForWizard: Room | null;\n  onCloseBookingWizard: () => void;\n  isWizardOpen: boolean;\n}\n\nexport default function GuestView({\n  language,\n  activeTab,\n  activeBooking,\n  onBookingComplete,\n  onOpenBookingWizard,\n  selectedRoomForWizard,\n  onCloseBookingWizard,\n  isWizardOpen\n}: GuestViewProps) {\n  const [activeSubTab, setActiveSubTab] = useState<\'intro\' | \'dining\' | \'spa\'>(\'intro\');\n  const [partySize, setPartySize] = useState(2);\n  const [diningDate, setDiningDate] = useState(\'2026-06-16\');\n  const [diningHour, setDiningHour] = useState(\'19:30\');\n  const [diningSubmitted, setDiningSubmitted] = useState(false);\n\n  const getLabel = (key: string) => {\n    return DICTIONARY[key]?.[language] || key;\n  };\n\n  const handleBookDining = () => {\n    setDiningSubmitted(true);\n    setTimeout(() => setDiningSubmitted(false), 5000);\n  };\n\n  return (\n    <div className=\"bg-[#F5F1EA] text-[#0B0D10] font-sans pb-16\">\n      \n      {/* HOME PAGE TAB */}\n      {activeTab === \'home\' && (\n        <div className=\"space-y-12\">\n          {/* Sub-navigation bar inside HOME dashboard */}\n          <div className=\"flex justify-center border-b border-[#86736F]/20 bg-white/40 sticky top-16 z-30 py-2 select-none\">\n            <div className=\"flex gap-1 bg-[#EEEDF2] p-1 text-[10px] font-mono font-bold\">\n              {([\'intro\', \'dining\', \'spa\'] as const).map((sub) => {\n                const subLabels = { intro: \'JOURNEY\', dining: \'THE BRICK & IRON\', spa: \'THE SANCTUARY SPA\' };\n                return (\n                  <button\n                    key={sub}\n                    id={`sub-tab-${sub}`}\n                    onClick={() => setActiveSubTab(sub)}\n                    className={`px-3 py-1.5 transition-all uppercase ${\n                      activeSubTab === sub\n                        ? \'bg-[#7A3A2E] text-white\'\n                        : \'text-stone-600 hover:text-[#7A3A2E]\'\n                    }`}\n                  >\n                    {subLabels[sub]}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* INTRO JOURNEY PANEL */}\n          {activeSubTab === \'intro\' && (\n            <div className=\"space-y-12 px-4 md:px-12 max-w-4xl mx-auto\">\n              \n              {/* Massive Cinematic Hero Banner with Text Overlay */}\n              <div className=\"relative h-[480px] w-full bg-cover bg-center select-none\" style={{ backgroundImage: `url(\'https://lh3.googleusercontent.com/aida-public/AB6AXuACA1bW6pzkHrNaWU7651J1uvHwuF48gcD38-P49yYDemIgPKkZ_boZLkpEwZgqtVyiyDGTR3xcwEXuqt73xpKIKz0TgpQmrj1rQkJq0rjnLnhMPx0RjcTTyyoS1JUA3y7D5cnzOaCpQzhGLNEo0SjqZ4YU4I6jlBblW72d7VkAcs1O8_sPTr4EZ3CeDpIkVSgvtG5-lu29R4EJU6evVVR7jwJxvuoeGxJsUPg2MjDFnJ2Naprb-VmC73Lw3laRIQzq7UbohZ8TdS_R\')` }}>\n                <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/10 flex flex-col justify-end p-8 md:p-12 text-white\">\n                  <span className=\"text-[10px] font-mono tracking-[0.2em] opacity-80 mb-2 uppercase text-[#B89B5E] font-bold\">\n                    {getLabel(\'hero_subtitle\')}\n                  </span>\n                  <h1 className=\"font-headline-xl text-3xl md:text-5xl font-black tracking-tight leading-tight max-w-xl text-[#F5F1EA]\">\n                    {getLabel(\'hero_title\')}\n                  </h1>\n                </div>\n              </div>\n\n              {/* Editorial Intro Narrative */}\n              <div className=\"text-center max-w-2xl mx-auto space-y-4 py-6\">\n                <span className=\"font-mono text-xs text-[#7A3A2E] tracking-widest font-black uppercase\">\n                  {getLabel(\'section1_num\')}\n                </span>\n                <h2 className=\"font-headline-lg text-2xl md:text-3xl text-[#5D241A] font-bold\">\n                  {getLabel(\'section1_title\')}\n                </h2>\n                <p className=\"text-[#534340] leading-relaxed text-sm md:text-base\">\n                  {getLabel(\'section1_desc\')}\n                </p>\n              </div>\n\n              {/* Aesthetic Material Pairings Grid */}\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 select-none\">\n                <div className=\"space-y-4\">\n                  <div className=\"h-64 overflow-hidden\">\n                    <img \n                      className=\"w-full h-full object-cover grayscale opacity-90 hover:grayscale-0 transition-all duration-700\"\n                      src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCr4p6em0177fbmUi22y1r_j09M115Qc3c2mLjF70gMCGPLM49jbNZBrBZXN1eNkfk0SEVmsIbvU_yXtTHIUHQ5a-jOkEEwCEmHIJWmoqoNLX1o6OtLMQRO4O2GM-2Z5Q9kam3OSsVCUec47MtsnhghGSguAiZqRhNqVV9NoL6pATEYzYSHdSQ1hpS3i0U74UA7AlV4ejCKKFiqE6xcqZqs1_jnWQyi2f4ofnFkyObCd8vKMnfaGHq_OI8amMdJb_VcN9qfe6cSP1M-\" \n                      alt=\"Material Integrity\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                  </div>\n                  <h3 className=\"font-headline-md text-lg text-[#5D241A] font-bold\">\n                    {getLabel(\'craft_title\')}\n                  </h3>\n                  <p className=\"text-xs text-[#534340] leading-relaxed\">\n                    {getLabel(\'craft_desc\')}\n                  </p>\n                </div>\n\n                <div className=\"space-y-4\">\n                  <div className=\"h-64 overflow-hidden\">\n                    <img \n                      className=\"w-full h-full object-cover opacity-95\"\n                      src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAMJOTaYWp6dwSyET66aApi6HbIoGxv9GqWnPaHAvUwnLMAABWv-X9cKglK4Alf9wHsB4vupu9CiWyEk4unTzHoJ5SdJYxUFzKABK-45C9VUysS5PvfHyYZYWhHKJPT9JPHD8PyX88DuP5172ZPO0P7huYzY9BX5qLSDS3Bkjo90WKawZuUO6jjvUp3hkqTKzCLuhjWQz41IhuDbEzt0lNPTW87J5o8ImC7zJHcr1EgVy7s6HwJigj9i8JyRuKyQO0NKycyCkEDvrwQ\" \n                      alt=\"The Quietude\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                  </div>\n                  <h3 className=\"font-headline-md text-lg text-[#5D241A] font-bold\">\n                    {getLabel(\'space_title\')}\n                  </h3>\n                  <p className=\"text-xs text-[#534340] leading-relaxed\">\n                    {getLabel(\'space_desc\')}\n                  </p>\n                </div>\n              </div>\n\n              {/* Bottom Large Stillness Text Pattern */}\n              <div className=\"border-[#86736F]/40 border-t border-b py-8 text-center bg-[#7A3A2E]/5 select-none\">\n                <span className=\"font-mono text-[9px] tracking-[0.3em] text-[#7A3A2E] font-black uppercase mb-1.5 block\">\n                  {getLabel(\'stillness_banner\')}\n                </span>\n                <p className=\"font-headline-sm text-lg md:text-xl italic text-[#5D241A]\">\n                  \"Quietness is not empty, it is full of answer.\"\n                </p>\n              </div>\n\n              {/* The House Principles (List block) */}\n              <div className=\"space-y-4 pt-4\">\n                <h3 className=\"font-headline-lg text-xl text-center text-[#5D241A] font-black tracking-wider border-b pb-2 select-none\">\n                  {getLabel(\'house_principles\')}\n                </h3>\n                <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-[#534340] select-none\">\n                  <div className=\"p-4 border border-[#86736F]/20\">\n                    <span className=\"font-bold text-[#7A3A2E] block uppercase font-mono text-[10px] mb-1\">01. {getLabel(\'p1_title\')}</span>\n                    Real materials speak directly. High-contrast custom glazed Hijau Nyonya mosaics, kiln-fired tiles, and volcanic stone.\n                  </div>\n                  <div className=\"p-4 border border-[#86736F]/20\">\n                    <span className=\"font-bold text-[#7A3A2E] block uppercase font-mono text-[10px] mb-1\">02. {getLabel(\'p2_title\')}</span>\n                    We respect your presence. House staff operate with silent steps, minimizing unrequested physical visual intervention.\n                  </div>\n                  <div className=\"p-4 border border-[#86736F]/20\">\n                    <span className=\"font-bold text-[#7A3A2E] block uppercase font-mono text-[10px] mb-1\">03. {getLabel(\'p3_title\')}</span>\n                    Time is deceleration. Rooms are optimized dynamically to reset natural circadian rhythms soundlessly.\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* THE BRICK & IRON (DINING) PANEL */}\n          {activeSubTab === \'dining\' && (\n            <div className=\"space-y-10 px-4 md:px-12 max-w-4xl mx-auto\">\n              {/* Dining Cinematic Hero Banner */}\n              <div className=\"relative h-96 w-full bg-cover bg-center select-none\" style={{ backgroundImage: `url(\'https://lh3.googleusercontent.com/aida-public/AB6AXuDkB6TCeS9QAaIWChe7IYfvbuM47yjeswfLA7MGh9iKSsrEbWIOQjwHShJXiw1h4cP1Qj9iW0HbgMxhfjQib5n-10XnA2QpP023iz2JxwjDq_kq4Ve1tNqIbJRvtEAWwY7yQUci7oruVbN-Xjubi_KBrnuZprSkMNBoATWXRYq8CiLaTGC7RrL_5p8noYgakcPW5V2PAww-MbCGI5uXsNcaGj4MZPVrXXmm3wPOiOFd9eVa1LvE0h6wHSZXAuoSf1FbsfR8nPScziVG\')` }}>\n                <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-black/10 flex flex-col justify-end p-8 text-white\">\n                  <span className=\"text-[10px] font-mono tracking-[0.2em] opacity-80 mb-2 uppercase text-[#B89B5E] font-bold\">\n                    {getLabel(\'dining_subtitle\')}\n                  </span>\n                  <h2 className=\"font-headline-xl text-3xl font-black text-[#F5F1EA]\">\n                    {getLabel(\'dining_title\')}\n                  </h2>\n                </div>\n              </div>\n\n              {/* Culinary Philosophy narrative */}\n              <div className=\"max-w-xl mx-auto text-center space-y-3\">\n                <span className=\"font-mono text-[10px] text-[#7A3A2E] tracking-widest font-black uppercase\">\n                  {getLabel(\'seasonal_manifestations\')}\n                </span>\n                <p className=\"text-[#534340] text-sm leading-relaxed\">\n                  {getLabel(\'dining_desc\')}\n                </p>\n              </div>\n\n              {/* Progression Phases */}\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 pt-3 select-none\">\n                <div className=\"bg-white p-5 border border-[#86736F]/20 space-y-2\">\n                  <h4 className=\"font-headline-md text-base text-[#7A3A2E] font-bold\">{getLabel(\'phase1_title\')}</h4>\n                  <p className=\"text-xs text-[#534340] leading-relaxed\">\n                    {getLabel(\'phase1_desc\')}\n                  </p>\n                </div>\n                <div className=\"bg-white p-5 border border-[#86736F]/20 space-y-2\">\n                  <h4 className=\"font-headline-md text-base text-[#7A3A2E] font-bold\">{getLabel(\'phase2_title\')}</h4>\n                  <p className=\"text-xs text-[#534340] leading-relaxed\">\n                    {getLabel(\'phase2_desc\')}\n                  </p>\n                </div>\n                <div className=\"bg-white p-5 border border-[#86736F]/20 space-y-2\">\n                  <h4 className=\"font-headline-md text-base text-[#7A3A2E] font-bold\">{getLabel(\'phase3_title\')}</h4>\n                  <p className=\"text-xs text-[#534340] leading-relaxed\">\n                    {getLabel(\'phase3_desc\')}\n                  </p>\n                </div>\n              </div>\n\n              {/* Dining interactive Table Reservation Scheduler */}\n              <div className=\"border border-[#86736F]/30 p-6 bg-white/60\">\n                <h3 className=\"font-headline-md text-lg text-[#5D241A] mb-4 font-bold border-b pb-2 text-center uppercase\">\n                  {getLabel(\'secure_table\')}\n                </h3>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n                  <div>\n                    <label className=\"block text-[10px] font-mono tracking-widest text-[#534340] uppercase mb-1\">\n                      {getLabel(\'guests\')}\n                    </label>\n                    <select \n                      id=\"select-dining-guests\"\n                      value={partySize} \n                      onChange={(e) => setPartySize(parseInt(e.target.value))}\n                      className=\"w-full bg-white border border-[#86736F]/30 p-2 text-xs\"\n                    >\n                      <option value=\"1\">1 Seat</option>\n                      <option value=\"2\">2 Seats (Private Table)</option>\n                      <option value=\"3\">3 Seats</option>\n                      <option value=\"4\">4 Seats (Chef Hearth)</option>\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[10px] font-mono tracking-widest text-[#534340] uppercase mb-1\">\n                      {getLabel(\'calendar\')}\n                    </label>\n                    <input \n                      type=\"date\" \n                      id=\"input-dining-date\"\n                      value={diningDate} \n                      onChange={(e) => setDiningDate(e.target.value)}\n                      className=\"w-full bg-white border border-[#86736F]/30 p-1.5 text-xs rounded-none\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[10px] font-mono tracking-widest text-[#534340] uppercase mb-1\">\n                      {getLabel(\'available_hours\')}\n                    </label>\n                    <select \n                      id=\"select-dining-hour\"\n                      value={diningHour} \n                      onChange={(e) => setDiningHour(e.target.value)}\n                      className=\"w-full bg-white border border-[#86736F]/30 p-2 text-xs\"\n                    >\n                      <option value=\"18:00\">18:00 (Sunset Glow)</option>\n                      <option value=\"19:30\">19:30 (Hearth Ignition)</option>\n                      <option value=\"21:00\">21:00 (Obsidian Twilight)</option>\n                    </select>\n                  </div>\n                </div>\n\n                <button\n                  id=\"btn-dining-reserve\"\n                  onClick={handleBookDining}\n                  className=\"w-full bg-[#7A3A2E] text-white py-3 font-mono text-xs font-bold tracking-widest uppercase hover:bg-[#5D241A] mt-6 select-none\"\n                >\n                  {getLabel(\'request_reservation\')}\n                </button>\n\n                {diningSubmitted ? (\n                  <p className=\"text-[#466557] font-bold text-xs font-mono mt-3 text-center\">\n                    \342\234\223 Request logged against system registry code. Hearth allocation matches pending confirmation.\n                  </p>\n                ) : (\n                  <p className=\"text-[10px] text-[#534340]/50 text-center mt-2 italic font-mono uppercase\">\n                    {getLabel(\'reservation_subtext\')}\n                  </p>\n                )}\n              </div>\n            </div>\n          )}\n\n          {/* THE SANCTUARY WELLNESS SPA PANEL */}\n          {activeSubTab === \'spa\' && (\n            <div className=\"space-y-10 px-4 md:px-12 max-w-4xl mx-auto\">\n              \n              {/* Centered cinematic image */}\n              <div className=\"relative h-96 w-full bg-cover bg-center select-none\" style={{ backgroundImage: `url(\'https://lh3.googleusercontent.com/aida-public/AB6AXuAIu0BFbmGeuTDKAQzdypncSr-hCBWAZLU0HDCawYVKpikFMawiy_UeClWZAh9sjcud68UEoWi8bii3_jESPdeozDzN2vEJQsEr6b__js1M-_apXI7Jdk0cisV29vKIQ_Fhr4sddZOKd53JrALEcyl9zJ6A2DS8FzxpQWtUSM6Fy-gkVXym5qqJmET2EMAWGQHS2nh6yNnJunzwxb7KUTHxsMNtVJFeYu2_VgJv4fA_s-FGmG-1fmhBWnJJEJz_T2nUnhGtRyxdwhOE\')` }}>\n                <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 flex flex-col justify-end p-8 text-white\">\n                  <h2 className=\"font-headline-xl text-3xl font-black text-[#F5F1EA]\">\n                    {getLabel(\'spa_title\')}\n                  </h2>\n                </div>\n              </div>\n\n              {/* Quote block and introduction */}\n              <div className=\"max-w-2xl mx-auto text-center space-y-4\">\n                <span className=\"font-headline-md italic text-lg text-[#7A3A2E] block font-black\">\n                  {getLabel(\'spa_intro_quote\')}\n                </span>\n                <p className=\"text-[#534340] text-sm leading-relaxed\">\n                  {getLabel(\'spa_intro_body\')}\n                </p>\n              </div>\n\n              {/* Rituals list in design layout with image nodes */}\n              <div className=\"space-y-6 pt-3 select-none\">\n                <span className=\"block font-mono text-[10px] tracking-widest font-black text-[#7A3A2E] text-center uppercase\">\n                  {getLabel(\'curated_experiences\')}\n                </span>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n                  {/* Ritual 1 */}\n                  <div className=\"bg-white border border-[#86736F]/20 p-4 space-y-4\">\n                    <div className=\"h-56 overflow-hidden\">\n                      <img \n                        className=\"w-full h-full object-cover\"\n                        src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCT20K8chCKOyb-8ar2fQATc3-m1bXhPfwr5YMRoVy7rXgIABhQQAMi8hmiSDtUldwYsYTJz87R_O5CrQoMzIXyHkr5HqD9nSaGAfyKpVcXOaF8VpDxDzQp2P0i-Ln6opevOyrsmQ7fS9csDmGqClX426qDCL-Yo_Wa_a4pR_4vcCGKsFKPEjSKBJy1SZht1i1Yx5wba2EPkRQTL9Xoy5x5IdYI7iw6J-kgAeRT5_XZs6uFpSogKttBikYPTlaEr26WxkJv8Wko_RCq\" \n                        alt=\"Stone Bathing Ritual\"\n                        referrerPolicy=\"no-referrer\"\n                      />\n                    </div>\n                    <div className=\"space-y-2\">\n                      <h4 className=\"font-headline-sm font-bold text-base text-[#5D241A]\">{getLabel(\'stone_ritual\')}</h4>\n                      <p className=\"text-xs text-stone-600\">\n                        Volcanic basalt riverbeds are heated under kiln embers and immersed in mineral baths to draw micro-fatigue dynamically from bone connective linings.\n                      </p>\n                    </div>\n                  </div>\n\n                  {/* Ritual 2 */}\n                  <div className=\"bg-white border border-[#86736F]/20 p-4 space-y-4\">\n                    <div className=\"h-56 overflow-hidden\">\n                      <img \n                        className=\"w-full h-full object-cover\"\n                        src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAlLpdci3Ce3hQJi8TNFAY9wZx77ByALYprhuCP4iRLUXc4iAcUI0_UY6MoBBRi0-2EU7g5ivK_PbmM0w8_nqM7G31BlOJkYYp7wPOmSAfl12INUhaXoyGLYURafxMwqxiED9q79DhYDfswhCvPvZq7eeYyum5_VeEQxHNTIFoRn_-6pzS7np1kZIJmaY82VrdEEcALMZT7RKZrhDVflGTlwdzQn-dJra86sPEgX1b7hJih8FU2cFjX8vyZ0VuNmI4mopaz3ShvZEnS\" \n                        alt=\"Clay Wrap\"\n                        referrerPolicy=\"no-referrer\"\n                      />\n                    </div>\n                    <div className=\"space-y-2\">\n                       <h4 className=\"font-headline-sm font-bold text-base text-[#5D241A]\">{getLabel(\'clay_wrap\')}</h4>\n                       <p className=\"text-xs text-stone-600\">\n                         Utilizes our iconic glazed heritage tiles\' minerals and organic sediment, generating a skin-pore cell detoxifying mask from head to chest.\n                       </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Wellness call-down CTA section with pattern background */}\n              <div className=\"bg-[#5D241A] text-[#F5F1EA] p-8 text-center space-y-4 relative border border-[#7A3A2E] select-none\">\n                <h3 className=\"font-headline-lg text-xl text-[#B89B5E] font-bold\">\n                  {getLabel(\'reserve_moment\')}\n                </h3>\n                <p className=\"text-xs text-[#F5F1EA]/80 max-w-md mx-auto leading-relaxed\">\n                  {getLabel(\'reserve_moment_desc\')}\n                </p>\n                <button\n                  id=\"btn-spa-inquiry\"\n                  onClick={() => alert(\'Bespoke wellness inquiry routed. Sasalle Sanctuary concierge will engage shortly.\')}\n                  className=\"bg-[#B89B5E] text-[#0B0D10] px-6 py-2.5 font-mono text-[11px] font-black tracking-widest uppercase hover:bg-white transition-all text-stone-900 duration-300\"\n                >\n                  {getLabel(\'inquire_ritual\')}\n                </button>\n              </div>\n            </div>\n          )}\n\n        </div>\n      )}\n\n      {/* ROOMS PAGE SANCTUARIES */}\n      {activeTab === \'rooms\' && (\n        <div className=\"px-4 md:px-12 max-w-4xl mx-auto space-y-8 select-none\">\n          <div className=\"text-center space-y-2 py-4\">\n            <span className=\"font-mono text-xs text-[#7A3A2E] tracking-widest uppercase font-black\">\n              {getLabel(\'residential_architecture\')}\n            </span>\n            <h2 className=\"font-headline-lg text-2xl md:text-3xl text-[#5D241A] font-bold\">\n              {getLabel(\'sanctuaries_stillness\')}\n            </h2>\n          </div>\n\n          <div className=\"space-y-12\">\n            {ROOMS.map((room) => (\n              <div \n                key={room.id}\n                id={`room-card-${room.id}`}\n                className=\"bg-white border border-[#86736F]/20 overflow-hidden flex flex-col md:flex-row shadow-sm transition-all duration-300 hover:shadow-md\"\n              >\n                {/* Room Image */}\n                <div className=\"md:w-1/2 h-80 overflow-hidden\">\n                  <img \n                    className=\"w-full h-full object-cover select-none\"\n                    src={room.image} \n                    alt={room.name}\n                    referrerPolicy=\"no-referrer\"\n                  />\n                </div>\n\n                {/* Room copy details */}\n                <div className=\"md:w-1/2 p-6 md:p-8 flex flex-col justify-between\">\n                  <div className=\"space-y-3\">\n                    <div className=\"flex justify-between items-baseline\">\n                      <span className=\"font-mono text-[10px] text-[#7A3A2E] font-bold tracking-widest uppercase font-black\">\n                        {room.collection}\n                      </span>\n                      <span className=\"text-xs text-stone-500 font-mono\">\n                        {room.size} \342\200\242 {room.bed}\n                      </span>\n                    </div>\n\n                    <h3 className=\"font-headline-md text-xl font-bold text-[#5D241A]\">\n                      {room.name}\n                    </h3>\n                    \n                    <p className=\"text-xs text-[#534340] leading-relaxed\">\n                      {room.description}\n                    </p>\n\n                    <div className=\"text-[11px] font-mono text-stone-500 bg-[#EEEDF2]/40 p-2 border-l border-[#86736F]/60\">\n                      <strong>Highlight:</strong> {room.highlight}\n                    </div>\n                  </div>\n\n                  <div className=\"pt-6 border-t border-stone-100 flex items-center justify-between gap-2 mt-4\">\n                    <div>\n                      <span className=\"text-[10px] font-mono text-stone-500 uppercase block tracking-wider\">\n                        {getLabel(\'starting_from\')}\n                      </span>\n                      <span className=\"text-lg font-bold text-[#7A3A2E]\">\n                        ${room.price} USD <span className=\"text-xs font-normal text-stone-500\">/ night</span>\n                      </span>\n                    </div>\n\n                    <button \n                      id={`btn-book-${room.id}`}\n                      onClick={() => onOpenBookingWizard(room)}\n                      className=\"bg-[#5D241A] text-white px-5 py-2.5 font-mono text-[10px] font-black tracking-widest uppercase hover:bg-[#7A3A2E] cursor-pointer\"\n                    >\n                      {getLabel(\'view_sanctuary\')}\n                    </button>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n\n          {/* Elegant 4-dot motif underroom card lists */}\n          <div className=\"flex justify-center gap-1.5 py-6\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-[#7A3A2E]/50\" />\n            <span className=\"w-1.5 h-1.5 rounded-full bg-[#7A3A2E]/20\" />\n            <span className=\"w-1.5 h-1.5 rounded-full bg-[#7A3A2E]/20\" />\n            <span className=\"w-1.5 h-1.5 rounded-full bg-[#7A3A2E]/20\" />\n          </div>\n        </div>\n      )}\n\n      {/* POPUP OVERLAY WIZARD */}\n      {isWizardOpen && selectedRoomForWizard && (\n        <div className=\"fixed inset-0 z-50 bg-black/60 flex items-center justify-center p-4 backdrop-blur-sm overflow-y-auto\">\n          <BookingWizard \n            room={selectedRoomForWizard}\n            onBookingComplete={onBookingComplete}\n            onClose={onCloseBookingWizard}\n            language={language}\n          />\n        </div>\n      )}\n\n    </div>\n  );\n}\n"
    }
