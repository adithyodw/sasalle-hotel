    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState } from \'react\';\nimport { Room, Booking, BookingPreference } from \'../types\';\nimport { Calendar, Users, Award, Car, Check, ChevronRight, Sparkles, Sliders } from \'lucide-react\';\nimport { ROOMS } from \'../data\';\n\ninterface BookingWizardProps {\n  room: Room;\n  onBookingComplete: (booking: Booking) => void;\n  onClose: () => void;\n  language: string;\n}\n\nexport default function BookingWizard({ room, onBookingComplete, onClose, language }: BookingWizardProps) {\n  const [step, setStep] = useState<1 | 2 | 3>(1);\n  const [guests, setGuests] = useState<number>(2);\n  const [checkIn, setCheckIn] = useState<string>(\'2026-06-15\');\n  const [checkOut, setCheckOut] = useState<string>(\'2026-06-18\');\n  const [promoCode, setPromoCode] = useState<string>(\'\');\n  const [promoDiscount, setPromoDiscount] = useState<number>(0);\n  const [promoApplied, setPromoApplied] = useState<boolean>(false);\n  const [selectedBundle, setSelectedBundle] = useState<\'none\' | \'botanical\' | \'epicurean\'>(\'none\');\n\n  // Preferences\n  const [pillow, setPillow] = useState<BookingPreference[\'pillowType\']>(\'memory\');\n  const [roomTemp, setRoomTemp] = useState<number>(21.5);\n  const [dietary, setDietary] = useState<string>(\'\');\n  const [airportPickup, setAirportPickup] = useState<boolean>(true);\n  const [flightNum, setFlightNum] = useState<string>(\'SQ-954\');\n  const [arrivalTime, setArrivalTime] = useState<string>(\'15:15\');\n  const [pantryItems, setPantryItems] = useState<string[]>([\'Vanuatu Cocoa Beans\']);\n  const [vehiclePref, setVehiclePref] = useState<BookingPreference[\'airportTransfer\'][\'vehiclePref\']>(\'s-class\');\n\n  const baseNights = 3;\n  const roomRate = room.price;\n  const promoRateMultiplier = promoApplied ? (1 - promoDiscount) : 1;\n  const bundleAddition = selectedBundle === \'botanical\' ? 250 : selectedBundle === \'epicurean\' ? 400 : 0;\n  \n  const subTotal = (roomRate * baseNights + bundleAddition) * promoRateMultiplier;\n  const taxAndService = subTotal * 0.21; // 21% Government tax & high-end service charge customary in luxury Indonesia spa hotels\n  const totalAmount = subTotal + taxAndService;\n\n  const handleApplyPromo = () => {\n    const code = promoCode.toUpperCase().trim();\n    if (code === \'STILLNESS\') {\n      setPromoDiscount(0.15);\n      setPromoApplied(true);\n    } else if (code === \'HERITAGE\') {\n      setPromoDiscount(0.10);\n      setPromoApplied(true);\n    } else {\n      alert(\'Code unrecognized across Sasalle registry.\');\n    }\n  };\n\n  const handleTogglePantry = (item: string) => {\n    if (pantryItems.includes(item)) {\n      setPantryItems(pantryItems.filter(p => p !== item));\n    } else {\n      setPantryItems([...pantryItems, item]);\n    }\n  };\n\n  const executeReservationComplete = () => {\n    const newBooking: Booking = {\n      id: `RSV-${Math.floor(1000 + Math.random() * 9000)}`,\n      roomId: room.id,\n      roomName: room.name,\n      checkIn,\n      checkOut,\n      guests,\n      totalAmount: Math.round(totalAmount),\n      promoCode: promoApplied ? promoCode.toUpperCase() : undefined,\n      packageName: selectedBundle !== \'none\' ? `${selectedBundle === \'botanical\' ? \'Botanical Wellness\' : \'Epicurean Feast\'}` : undefined,\n      status: \'confirmed\',\n      preferences: {\n        pillowType: pillow,\n        roomTemp,\n        dietaryNotes: dietary || \'None declared\',\n        preArrivalPantry: pantryItems,\n        airportTransfer: {\n          enabled: airportPickup,\n          flightNumber: flightNum,\n          arrivalTime,\n          vehiclePref\n        }\n      }\n    };\n    onBookingComplete(newBooking);\n    setStep(3);\n  };\n\n  return (\n    <div className=\"bg-[#F5F1EA] text-[#0B0D10] p-6 border-2 border-[#86736F] max-w-xl mx-auto rounded-none relative\">\n      <button \n        id=\"btn-close-wizard\"\n        onClick={onClose} \n        className=\"absolute top-4 right-4 font-mono text-sm hover:text-[#7A3A2E] border border-black/10 px-2 py-1\"\n      >\n        [ ESCAPE ]\n      </button>\n\n      {/* Progress Line */}\n      <div className=\"flex justify-between items-center mb-10 border-b border-[#86736F]/20 pb-4\">\n        <h3 className=\"font-headline-md text-xl text-[#5D241A] font-bold\">\n          {step === 1 ? \'Step I: Sanctuary Setup\' : step === 2 ? \'Step II: Personalize Presence\' : \'Step III: Complete Sanction\'}\n        </h3>\n        <span className=\"font-mono text-xs text-[#534340]/60\">\n          STEP {step} / 3\n        </span>\n      </div>\n\n      {step === 1 && (\n        <div className=\"space-y-6\">\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-[10px] font-mono tracking-widest text-[#534340]/80 uppercase mb-1\">\n                Sanctuary Target\n              </label>\n              <div className=\"font-bold border-b border-black/20 pb-1 text-[#5D241A]\">\n                {room.name}\n              </div>\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-mono tracking-widest text-[#534340]/80 uppercase mb-1\">\n                Nightly Rate\n              </label>\n              <div className=\"font-bold border-b border-black/20 pb-1 text-right text-[#5D241A]\">\n                ${room.price} USD\n              </div>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-[10px] font-mono tracking-widest text-[#534340]/80 uppercase mb-1\">\n                CHECK-IN\n              </label>\n              <input \n                type=\"date\"\n                id=\"input-check-in\" \n                value={checkIn}\n                onChange={(e) => setCheckIn(e.target.value)}\n                className=\"w-full bg-transparent border-b border-[#86736F] focus:border-[#7A3A2E] focus:outline-none py-1 text-sm font-semibold rounded-none\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-mono tracking-widest text-[#534340]/80 uppercase mb-1\">\n                CHECK-OUT\n              </label>\n              <input \n                type=\"date\"\n                id=\"input-check-out\" \n                value={checkOut}\n                onChange={(e) => setCheckOut(e.target.value)}\n                className=\"w-full bg-transparent border-b border-[#86736F] focus:border-[#7A3A2E] focus:outline-none py-1 text-sm font-semibold rounded-none\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-[10px] font-mono tracking-widest text-[#534340]/80 uppercase mb-2\">\n              Package Bundling Accent\n            </label>\n            <div className=\"space-y-3\">\n              <label className={`block border p-3 cursor-pointer transition-all ${selectedBundle === \'none\' ? \'border-[#7A3A2E] bg-white\' : \'border-[#86736F]/20\'}`}>\n                <input \n                  type=\"radio\" \n                  name=\"bundle\" \n                  checked={selectedBundle === \'none\'} \n                  onChange={() => setSelectedBundle(\'none\')} \n                  className=\"hidden\"\n                />\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"font-mono text-xs font-bold uppercase\">Restoration Standard Stay</span>\n                  <span className=\"text-xs font-semibold\">Included</span>\n                </div>\n                <p className=\"text-[11px] text-[#534340]/70 mt-1\">\n                  Includes raw herbal welcome blends and structural silence.\n                </p>\n              </label>\n\n              <label className={`block border p-3 cursor-pointer transition-all ${selectedBundle === \'botanical\' ? \'border-[#7A3A2E] bg-[#466557]/10\' : \'border-[#86736F]/20\'}`}>\n                <input \n                  type=\"radio\" \n                  name=\"bundle\" \n                  checked={selectedBundle === \'botanical\'} \n                  onChange={() => setSelectedBundle(\'botanical\')} \n                  className=\"hidden\"\n                />\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"font-mono text-xs font-bold text-[#466557] uppercase\">The Botanical Spa Ritual</span>\n                  <span className=\"text-xs font-bold text-[#466557]\">+ $250 USD</span>\n                </div>\n                <p className=\"text-[11px] text-[#534340]/70 mt-1\">\n                  Adds (1) custom Stone Bathing Ritual and full-set Hijau Nyonya Clay Wrap session.\n                </p>\n              </label>\n\n              <label className={`block border p-3 cursor-pointer transition-all ${selectedBundle === \'epicurean\' ? \'border-[#7A3A2E] bg-white\' : \'border-[#86736F]/20\'}`}>\n                <input \n                  type=\"radio\" \n                  name=\"bundle\" \n                  checked={selectedBundle === \'epicurean\'} \n                  onChange={() => setSelectedBundle(\'epicurean\')} \n                  className=\"hidden\"\n                />\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"font-mono text-xs font-bold text-[#7A3A2E] uppercase\">The Epicurean Brick Manifestation</span>\n                  <span className=\"text-xs font-bold text-[#7A3A2E]\">+ $400 USD</span>\n                </div>\n                <p className=\"text-[11px] text-[#534340]/70 mt-1\">\n                  Adds full phase five-course culinary progression at The Brick & Iron with curated wine matches.\n                </p>\n              </label>\n            </div>\n          </div>\n\n          {/* Promo Code System */}\n          <div className=\"pt-2 border-t border-[#86736F]/20\">\n            <label className=\"block text-[10px] font-mono tracking-widest text-[#534340]/80 uppercase mb-1\">\n              PROMO CODE\n            </label>\n            <div className=\"flex gap-2\">\n              <input \n                type=\"text\" \n                id=\"input-promo\"\n                placeholder=\"PROMPT CODE (e.g. STILLNESS)\" \n                value={promoCode}\n                onChange={(e) => setPromoCode(e.target.value)}\n                className=\"flex-1 bg-white border border-[#86736F]/40 focus:outline-none focus:border-[#7A3A2E] px-3 py-1.5 font-mono text-xs uppercase\"\n              />\n              <button \n                id=\"btn-apply-promo\"\n                onClick={handleApplyPromo}\n                className=\"bg-[#5D241A] text-[#F5F1EA] px-4 py-1.5 text-xs font-mono font-bold hover:bg-[#7A3A2E]\"\n              >\n                APPLY\n              </button>\n            </div>\n            {promoApplied && (\n              <p className=\"text-[#466557] text-xs font-bold mt-1.5 flex items-center gap-1\">\n                <Check size={12} /> {promoDiscount * 100}% discount registered against \"{promoCode.toUpperCase()}\"!\n              </p>\n            )}\n            <p className=\"text-[10px] text-[#534340]/50 italic mt-1\">\n              Tip: Enter \'STILLNESS\' for 15% discount as an inaugural guest.\n            </p>\n          </div>\n\n          <button \n            id=\"btn-next-step\"\n            onClick={() => setStep(2)}\n            className=\"w-full bg-[#7A3A2E] text-white py-4 font-mono text-xs font-black tracking-widest uppercase hover:bg-[#5D241A] flex items-center justify-center gap-2 mt-4\"\n          >\n            FORWARD TO DESIGN PREFERENCES\n            <ChevronRight size={14} />\n          </button>\n        </div>\n      )}\n\n      {step === 2 && (\n        <div className=\"space-y-6\">\n          <p className=\"text-xs text-[#534340]/70 italic border-l-2 border-[#7A3A2E] pl-3 py-1\">\n            \"These settings are mapped directly into your room computer node ahead of physical arrival.\"\n          </p>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-[10px] font-mono tracking-widest text-[#534340]/80 uppercase mb-2\">\n                Pillow Configuration\n              </label>\n              <select\n                id=\"select-pillow\"\n                value={pillow}\n                onChange={(e) => setPillow(e.target.value as BookingPreference[\'pillowType\'])}\n                className=\"w-full bg-white border border-[#86736F]/40 p-2 font-mono text-xs focus:outline-none rounded-none\"\n              >\n                <option value=\"feather\">Natural White Goose Feather (Soft)</option>\n                <option value=\"memory\">Volcanic Mineral Infused Memory (Support)</option>\n                <option value=\"buckwheat\">Indonesian Buckwheat Husk (Cooling)</option>\n                <option value=\"none\">Empty Plinth (Austere Minimal)</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-mono tracking-widest text-[#534340]/80 uppercase mb-2\">\n                Room Climate Control\n              </label>\n              <div className=\"flex items-center gap-3\">\n                <input \n                  type=\"range\" \n                  min={18} \n                  max={26} \n                  step={0.5} \n                  value={roomTemp}\n                  onChange={(e) => setRoomTemp(parseFloat(e.target.value))}\n                  className=\"flex-1 accent-[#7A3A2E]\"\n                />\n                <span className=\"font-mono text-xs font-bold bg-white px-2 py-1 border border-[#86736F]/40\">\n                  {roomTemp}\302\260C\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* Airport Pickup */}\n          <div className=\"border border-[#86736F]/20 p-4 bg-white/40\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <label className=\"flex items-center gap-2 cursor-pointer font-bold text-xs font-mono uppercase text-[#5D241A]\">\n                <input \n                  type=\"checkbox\" \n                  checked={airportPickup} \n                  onChange={(e) => setAirportPickup(e.target.checked)}\n                  className=\"rounded-none accent-[#7A3A2E]\"\n                />\n                Secure Private Batam Port Pickup\n              </label>\n              <Car size={16} className=\"text-[#5D241A]\" />\n            </div>\n\n            {airportPickup && (\n              <div className=\"grid grid-cols-3 gap-3 pt-2\">\n                <div>\n                  <label className=\"block text-[9px] font-mono text-[#534340]/80 uppercase mb-1\">Flight/Ferry</label>\n                  <input \n                    type=\"text\" \n                    value={flightNum} \n                    onChange={(e) => setFlightNum(e.target.value)}\n                    className=\"w-full bg-white border border-[#86736F]/30 px-2 py-1 text-xs\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-[9px] font-mono text-[#534340]/80 uppercase mb-1\">Est. Arrival Time</label>\n                  <input \n                    type=\"text\" \n                    value={arrivalTime} \n                    onChange={(e) => setArrivalTime(e.target.value)}\n                    className=\"w-full bg-white border border-[#86736F]/30 px-2 py-1 text-xs\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-[9px] font-mono text-[#534340]/80 uppercase mb-1\">Vehicle Selection</label>\n                  <select \n                    value={vehiclePref} \n                    onChange={(e) => setVehiclePref(e.target.value as any)}\n                    className=\"w-full bg-white border border-[#86736F]/30 p-1 text-xs\"\n                  >\n                    <option value=\"s-class\">Mercedes S-Class</option>\n                    <option value=\"velfire\">Toyota Vellfire Lounge</option>\n                    <option value=\"eqs\">Mercedes electric EQS</option>\n                  </select>\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Pantry selection */}\n          <div>\n            <label className=\"block text-[10px] font-mono tracking-widest text-[#534340]/80 uppercase mb-2\">\n              Bespoke Pantry Pre-Stock\n            </label>\n            <div className=\"grid grid-cols-2 gap-2 text-xs\">\n              {[\n                \'Vanuatu Cocoa Beans\',\n                \'Fermented Papaya Essence\',\n                \'Local Batam Wildflower Honey\',\n                \'Cold Brew Sumatran Peaberry\',\n                \'Raw Aloe Vera Water\'\n              ].map((item) => {\n                const isSelected = pantryItems.includes(item);\n                return (\n                  <button\n                    key={item}\n                    type=\"button\"\n                    onClick={() => handleTogglePantry(item)}\n                    className={`p-2 border text-left transition-all flex justify-between items-center ${\n                      isSelected ? \'bg-[#466557] text-white border-[#466557]\' : \'bg-white border-[#86736F]/20 text-[#534340]\'\n                    }`}\n                  >\n                    <span>{item}</span>\n                    {isSelected && <Check size={12} />}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-[10px] font-mono tracking-widest text-[#534340]/80 uppercase mb-1\">\n              Dietary Restrictions / In-Room Dining Directives\n            </label>\n            <input \n              type=\"text\" \n              placeholder=\"Allergies, organic preferences, fasting schedules...\" \n              value={dietary}\n              onChange={(e) => setDietary(e.target.value)}\n              className=\"w-full bg-white border border-[#86736F]/40 p-2 text-xs focus:outline-none focus:border-[#7A3A2E]\"\n            />\n          </div>\n\n          <div className=\"flex gap-2\">\n            <button \n              id=\"btn-back-step\"\n              onClick={() => setStep(1)}\n              className=\"w-1/3 border border-[#86736F] text-[#534340] py-4 text-xs font-mono uppercase font-bold\"\n            >\n              BACK\n            </button>\n            <button \n              id=\"btn-complete-booking\"\n              onClick={executeReservationComplete}\n              className=\"flex-1 bg-[#5D241A] text-[#F5F1EA] py-4 text-xs font-mono font-black tracking-widest uppercase hover:bg-[#7A3A2E]\"\n            >\n              COMPLETE BOOKING\n            </button>\n          </div>\n        </div>\n      )}\n\n      {step === 3 && (\n        <div className=\"text-center space-y-6 py-6\">\n          <div className=\"w-16 h-16 bg-[#466557] text-[#F5F1EA] rounded-full flex items-center justify-center mx-auto shadow-lg\">\n            <Check size={32} />\n          </div>\n\n          <div>\n            <h4 className=\"font-headline-lg text-[#5D241A] text-2xl\">\n              Sanctuary Confirmed\n            </h4>\n            <p className=\"font-mono text-xs text-[#534340] mt-2 tracking-widest font-black uppercase\">\n              RESERVATION COMPLETED SUCCESSFULLY\n            </p>\n          </div>\n\n          <div className=\"bg-white border border-[#86736F]/30 p-4 text-left font-mono text-[11px] space-y-2 mt-4\">\n            <div className=\"flex justify-between border-b pb-1\">\n              <span className=\"text-stone-500\">RESIST COMP ID:</span>\n              <span className=\"font-bold\">SAS-8104</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span className=\"text-stone-500\">ROOM:</span>\n              <span className=\"font-bold\">{room.name}</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span className=\"text-stone-500\">DATES:</span>\n              <span className=\"font-bold\">{checkIn} to {checkOut}</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span className=\"text-stone-500\">PACKAGES:</span>\n              <span className=\"font-bold uppercase text-[#466557]\">\n                {selectedBundle !== \'none\' ? `${selectedBundle}` : \'Restoration Standard\'}\n              </span>\n            </div>\n            {airportPickup && (\n              <div className=\"flex justify-between\">\n                <span className=\"text-stone-500\">PORT TRANSFER:</span>\n                <span className=\"font-bold uppercase\">{vehiclePref} Lounge</span>\n              </div>\n            )}\n            <div className=\"flex justify-between border-t border-dashed pt-2 font-bold text-sm text-[#7A3A2E]\">\n              <span>TOTAL (TAX INC):</span>\n              <span>${Math.round(totalAmount).toLocaleString()} USD</span>\n            </div>\n          </div>\n\n          <p className=\"text-xs text-[#534340]/70 italic max-w-sm mx-auto\">\n            \"Your digital entry code has been provisioned. Please head over to the Digital Key section to pre-authorize your physical unlocking sequence.\"\n          </p>\n\n          <button \n            id=\"btn-close-and-view\"\n            onClick={onClose}\n            className=\"w-full bg-[#5D241A] text-white py-4 font-mono text-xs font-black tracking-widest uppercase hover:bg-[#7A3A2E]\"\n          >\n            DISMISS AND RETURN\n          </button>\n        </div>\n      )}\n    </div>\n  );\n}\n"
