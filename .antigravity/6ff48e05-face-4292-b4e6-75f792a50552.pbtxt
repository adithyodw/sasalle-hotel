  file_change {
    absolute_path_uri: "file:///src/components/DigitalKey.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useRef, useEffect } from \'react\';\nimport { Booking, Language } from \'../types\';\nimport { DICTIONARY } from \'../data\';\nimport { Key, Unlock, Lock, Sparkles, Check } from \'lucide-react\';\n\ninterface DigitalKeyProps {\n  activeBooking: Booking | null;\n  language: Language;\n}\n\nexport default function DigitalKey({ activeBooking, language }: DigitalKeyProps) {\n  const [isUnlocked, setIsUnlocked] = useState(false);\n  const [sliderVal, setSliderVal] = useState(0);\n  const [rippleActive, setRippleActive] = useState(false);\n  const sliderRef = useRef<HTMLInputElement>(null);\n\n  const getLabel = (key: string) => {\n    return DICTIONARY[key]?.[language] || key;\n  };\n\n  const handleSliderChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const val = parseInt(e.target.value);\n    setSliderVal(val);\n\n    if (val >= 95) {\n      setIsUnlocked(true);\n      setSliderVal(100);\n      setRippleActive(true);\n      // Trigger temporary haptic nfc feel\n      setTimeout(() => setRippleActive(false), 2500);\n    }\n  };\n\n  const handleRelock = () => {\n    setIsUnlocked(false);\n    setSliderVal(0);\n  };\n\n  return (\n    <div className=\"bg-[#F5F1EA] text-[#0B0D10] p-6 max-w-sm mx-auto min-h-[500px] flex flex-col justify-between border border-[#86736F]/20\">\n      <div className=\"text-center space-y-2\">\n        <h3 className=\"font-headline-lg text-xl text-[#5D241A] tracking-wider uppercase font-bold\">\n          {getLabel(\'key_title\')}\n        </h3>\n        <p className=\"text-xs text-[#534340]/70 max-w-xs mx-auto\">\n          {getLabel(\'key_desc\')}\n        </p>\n      </div>\n\n      {/* Actual NFC Animation Visualizer */}\n      <div className=\"relative my-10 flex items-center justify-center\">\n        {/* Clay Breeze Block Motif Layer */}\n        <div className=\"absolute inset-0 bg-[radial-gradient(circle,#86736F_1px,transparent_1px)] bg-[size:16px_16px] opacity-10 rounded-full w-56 h-56 mx-auto\" />\n\n        {/* Outer Pulsing Ripples */}\n        <div className={`absolute w-44 h-44 rounded-full border-2 border-dashed transition-all duration-1000 ${\n          isUnlocked \n            ? \'border-[#466557]/40 scale-110 animate-spin\' \n            : \'border-[#7A3A2E]/20\'\n        }`} />\n        \n        <div className={`absolute w-36 h-36 rounded-full border transition-all duration-700 ${\n          rippleActive ? \'scale-125 border-[#466557] opacity-100\' : \'scale-100 border-[#86736F]/20 opacity-40\'\n        }`} />\n\n        {/* Core Ceramic Key Button */}\n        <div \n          onClick={() => isUnlocked && handleRelock()}\n          className={`w-28 h-28 rounded-full flex flex-col items-center justify-center cursor-pointer transition-all duration-500 shadow-xl ${\n            isUnlocked \n              ? \'bg-[#466557] text-[#F5F1EA]\' \n              : \'bg-white border-2 border-[#86736F]/40 text-[#5D241A] hover:border-[#7A3A2E]\'\n          }`}\n        >\n          {isUnlocked ? (\n            <>\n              <Unlock size={32} className=\"animate-bounce\" />\n              <span className=\"font-mono text-[9px] mt-2 tracking-widest font-black\">UNLOCKED</span>\n            </>\n          ) : (\n            <>\n              <Lock size={32} />\n              <span className=\"font-mono text-[9px] mt-2 tracking-widest font-black\">LOCKED</span>\n            </>\n          )}\n        </div>\n      </div>\n\n      {activeBooking ? (\n        <div className=\"space-y-6\">\n          {/* Reservation stats metadata inside the key container */}\n          <div className=\"bg-white/60 border border-[#86736F]/20 p-3.5 text-center rounded-none select-none\">\n            <span className=\"text-[9px] font-mono tracking-widest text-[#534340]/60 uppercase\">Active Sanctuary Residence</span>\n            <p className=\"font-headline-md text-base text-[#5D241A] font-bold mt-1\">\n              {activeBooking.roomName}\n            </p>\n            <div className=\"flex justify-between font-mono text-[10px] text-[#534340]/80 mt-2 border-t pt-2 border-stone-200\">\n              <span>RM: {activeBooking.id.replace(\'RSV-\', \'#\')}</span>\n              <span>TEMP: {activeBooking.preferences.roomTemp}\302\260C</span>\n              <span className=\"text-[#466557] font-black\">SECURE CONNECTED</span>\n            </div>\n          </div>\n\n          {isUnlocked ? (\n            <div className=\"text-center\">\n              <p className=\"text-[#466557] font-bold text-xs flex items-center justify-center gap-1.5 animate-pulse\">\n                <Check size={14} /> {getLabel(\'unlocked_message\')}\n              </p>\n              <button \n                id=\"btn-relock\"\n                onClick={handleRelock}\n                className=\"mt-3 text-[10px] font-mono tracking-widest text-[#7A3A2E] underline border border-transparent hover:border-[#7A3A2E]/20 px-2 py-1\"\n              >\n                RE-ENGAGE SECURE RESTRAINT\n              </button>\n            </div>\n          ) : (\n            <div className=\"space-y-2\">\n              <div className=\"relative flex items-center\">\n                <input \n                  type=\"range\"\n                  id=\"slider-unlock\"\n                  ref={sliderRef}\n                  min=\"0\"\n                  max=\"100\"\n                  value={sliderVal}\n                  onChange={handleSliderChange}\n                  className=\"w-full h-11 bg-white/70 border border-[#86736F]/40 appearance-none outline-none cursor-pointer rounded-none relative accent-[#7A3A2E]\" \n                />\n                \n                {/* Visual Label */}\n                <div className=\"absolute inset-0 flex items-center justify-center pointer-events-none text-[9px] font-mono tracking-[0.2em] text-[#534340]/80 uppercase font-bold\">\n                  {getLabel(\'slide_to_unlock\')}\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n      ) : (\n        <div className=\"bg-[#7A3A2E]/5 border border-[#7A3A2E]/20 p-4 text-center space-y-3 rounded-none\">\n          <p className=\"text-xs text-[#7A3A2E]/80 italic\">\n            \"No active residential stay sequence detected.\"\n          </p>\n          <p className=\"text-[11px] text-[#534340]/80 leading-relaxed\">\n            A digital room key is only issued once you have selected and confirmed an active stay under the **Sanctuaries** menu.\n          </p>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    }
