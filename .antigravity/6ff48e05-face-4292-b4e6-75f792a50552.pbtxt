        }
        lines {
          text: "  \"spa_intro_quote\": {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    \"en\": \"\\\"Restoration through architectural silence.\\\"\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    \"id\": \"\\\"Pemulih jiwa melalui arsitektur yang hening.\\\"\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    \"zh\": \"\342\200\234\345\200\237\351\235\231\351\273\230\347\232\204\347\240\226\347\237\263\347\247\251\345\272\217\351\207\215\345\241\221\347\226\262\346\203\253\344\271\213\350\272\257\342\200\235\""
