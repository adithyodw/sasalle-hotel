    replacement_chunks {
      replacement_content: "import { Booking, HousekeepingRequest, InRoomDiningOrder, ActivityLog } from \'../types\';\nimport { Shield, Sparkles, TrendingUp, Users, Coffee, Truck, Server, Layers } from \'lucide-react\';\n\ninterface AdminViewProps {\n  bookings: Booking[];\n  housekeeping: HousekeepingRequest[];\n  diningOrders: InRoomDiningOrder[];\n  logs: ActivityLog[];\n  onToggleHousekeeping: (id: string) => void;\n  onToggleDining: (id: string) => void;\n  onCancelBooking: (id: string) => void;\n}\n\nexport default function AdminView({\n  bookings,\n  housekeeping,\n  diningOrders,\n  logs,\n  onToggleHousekeeping,\n  onToggleDining,\n  onCancelBooking\n}: AdminViewProps) {\n  // Analytical estimates\n  const activeBookingsCount = bookings.filter(b => b.status === \'confirmed\').length;\n  const totalRevenue = bookings\n    .filter(b => b.status === \'confirmed\')\n    .reduce((acc, curr) => acc + curr.totalAmount, 0);\n\n  return (\n    <div className=\"bg-[#EEEDF2] text-[#0B0D10] p-6 min-h-screen\">\n      {/* Title block */}\n      <div className=\"border-b border-[#86736F]/40 pb-4 mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 select-none\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <Shield className=\"text-[#7A3A2E]\" size={20} />\n            <span className=\"font-mono text-xs tracking-widest font-black text-[#7A3A2E] uppercase\">\n              BOH OPERATIONS BACKSTAGE Portal\n            </span>\n          </div>\n          <h2 className=\"font-headline-lg text-2xl text-[#5D241A] font-bold mt-1\">\n            Sasalle Hospitality Ledger\n          </h2>\n        </div>\n        \n        {/* Connection status badges */}\n        <div className=\"flex gap-2\">\n          <span className=\"text-[10px] font-mono bg-[#466557]/10 text-[#466557] border border-[#466557]/40 px-2 py-1 uppercase font-bold\">\n            \342\227\217 PMS SYSTEM: SECURE SYNCD\n          </span>\n          <span className=\"text-[10px] font-mono bg-blue-50 text-blue-700 border border-blue-200 px-2 py-1 uppercase font-bold\">\n            GEMINI API: ON-CALL\n          </span>\n        </div>\n      </div>\n\n      {/* Analytics Bento Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 select-none\">\n        {/* KPI 1 */}\n        <div className=\"bg-white p-5 border border-[#86736F]/20 relative\">\n          <span className=\"text-[10px] font-mono text-[#534340]/60 uppercase tracking-wider block mb-2\">\n            ACTIVE REGISTRY INDEX\n          </span>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-3xl font-headline-lg font-bold text-[#5D241A]\">\n              {activeBookingsCount}\n            </span>\n            <span className=\"text-xs text-[#466557] font-bold\">Confirmed Stays</span>\n          </div>\n          <p className=\"text-[11px] text-[#534340]/70 mt-3 border-t pt-2 border-stone-100\">\n            Real-time synchronization against Batam Port passenger registers.\n          </p>\n        </div>\n\n        {/* KPI 2 */}\n        <div className=\"bg-white p-5 border border-[#86736F]/20 relative\">\n          <span className=\"text-[10px] font-mono text-[#534340]/60 uppercase tracking-wider block mb-2\">\n            GROSS LEDGER REVENUE\n          </span>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-3xl font-headline-lg font-bold text-[#5D241A]\">\n              ${totalRevenue.toLocaleString()}\n            </span>\n            <span className=\"text-xs text-[#534340] font-mono\">USD</span>\n          </div>\n          <p className=\"text-[11px] text-[#534340]/70 mt-3 border-t pt-2 border-stone-100\">\n            Including 21% Indonesian legal government taxes & resort fees.\n          </p>\n        </div>\n\n        {/* KPI 3 (Beautiful SVG Donut Chart for occupancy source attribution) */}\n        <div className=\"bg-white p-5 border border-[#86736F]/20 flex items-center gap-4\">\n          <div className=\"w-16 h-16 flex-shrink-0\">\n            <svg viewBox=\"0 0 36 36\" className=\"w-full h-full\">\n              <circle cx=\"18\" cy=\"18\" r=\"15.915\" fill=\"none\" stroke=\"#EEEDF2\" strokeWidth=\"4\" />\n              <circle cx=\"18\" cy=\"18\" r=\"15.915\" fill=\"none\" stroke=\"#7A3A2E\" strokeWidth=\"4\" strokeDasharray=\"45 55\" strokeDashoffset=\"100\" />\n              <circle cx=\"18\" cy=\"18\" r=\"15.915\" fill=\"none\" stroke=\"#466557\" strokeWidth=\"4\" strokeDasharray=\"30 70\" strokeDashoffset=\"55\" />\n              <circle cx=\"18\" cy=\"18\" r=\"15.915\" fill=\"none\" stroke=\"#B89B5E\" strokeWidth=\"4\" strokeDasharray=\"25 75\" strokeDashoffset=\"25\" />\n            </svg>\n          </div>\n          <div className=\"flex-1 text-[11px] font-mono leading-tight space-y-1\">\n            <span className=\"text-[10px] text-stone-500 block uppercase font-sans mb-1\">REvenue ATTRIBUTION</span>\n            <div className=\"flex justify-between\">\n              <span className=\"text-[#7A3A2E] font-bold\">\342\227\217 Heritage (45%)</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span className=\"text-[#466557] font-bold\">\342\227\217 Obsidian (30%)</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span className=\"text-[#B89B5E] font-bold\">\342\227\217 Ivory Pav. (25%)</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Operations Split */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* Column 1 & 2: Reservations & Live CRM Database */}\n        <div className=\"lg:col-span-2 space-y-6\">\n          <div className=\"bg-white p-6 border border-[#86736F]/20\">\n            <h3 className=\"font-headline-md text-lg text-[#5D241A] mb-4 font-bold border-b pb-2 flex justify-between items-center select-none\">\n              <span>Guest CRM registry database</span>\n              <span className=\"font-mono text-[10px] text-stone-400 font-normal\">SECURE HTTPS CONNECTION ENABLED</span>\n            </h3>\n\n            {bookings.length === 0 ? (\n              <p className=\"text-stone-400 text-xs italic py-4 text-center\">\n                No bookings lodged against current storage layer.\n              </p>\n            ) : (\n              <div className=\"overflow-x-auto\">\n                <table className=\"w-full text-left font-mono text-xs\">\n                  <thead>\n                    <tr className=\"border-b border-stone-200 text-stone-500\">\n                      <th className=\"py-2.5\">RSV ID</th>\n                      <th className=\"py-2.5\">SANCTUARY</th>\n                      <th className=\"py-2.5\">PERIOD</th>\n                      <th className=\"py-2.5\">CLIMATE</th>\n                      <th className=\"py-2.5 text-right\">LEDGER</th>\n                      <th className=\"py-2.5 text-right\">RECOVERY</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-stone-100\">\n                    {bookings.map((booking) => (\n                      <tr key={booking.id} className=\"hover:bg-[#EEEDF2]/40\">\n                        <td className=\"py-3.5 font-bold text-[#7A3A2E]\">{booking.id}</td>\n                        <td className=\"py-3.5 font-sans font-bold text-stone-800\">\n                          {booking.roomName}\n                          {booking.packageName && (\n                            <span className=\"block font-mono text-[9px] text-[#466557] font-black uppercase\">\n                              + Package: {booking.packageName}\n                            </span>\n                          )}\n                        </td>\n                        <td className=\"py-3.5 text-stone-600\">\n                          {booking.checkIn} \342\200\224 {booking.checkOut}\n                          <span className=\"block text-[10px] text-stone-400 font-bold\">\n                            {booking.guests} Guests \342\200\242 Priority transfer: {booking.preferences.airportTransfer.enabled ? \'YES\' : \'NO\'}\n                          </span>\n                        </td>\n                        <td className=\"py-3.5\">\n                          <span className=\"bg-blue-50 text-blue-700 px-1.5 py-0.5 border border-blue-200 font-bold\">\n                            {booking.preferences.roomTemp}\302\260C\n                          </span>\n                        </td>\n                        <td className=\"py-3.5 text-right font-bold text-[#5D241A]\">\n                          ${booking.totalAmount.toLocaleString()}\n                        </td>\n                        <td className=\"py-3.5 text-right\">\n                          <button\n                            id={`btn-cancel-${booking.id}`}\n                            onClick={() => onCancelBooking(booking.id)}\n                            className=\"bg-red-50 text-red-700 border border-red-200 px-2 py-1 text-[10px] font-bold hover:bg-red-100\"\n                          >\n                            VOID\n                          </button>\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            )}\n          </div>\n\n          {/* Activity Logs Telemetry */}\n          <div className=\"bg-white p-6 border border-[#86736F]/20 select-none\">\n            <h3 className=\"font-headline-md text-lg text-[#5D241A] mb-4 font-bold border-b pb-2\">\n              Operation Transaction Logs\n            </h3>\n            <div className=\"space-y-3 font-mono text-[11px] max-h-48 overflow-y-auto\">\n              {logs.map((log) => (\n                <div key={log.id} className=\"flex gap-3 justify-between items-start border-b border-stone-100 pb-2\">\n                  <div className=\"flex gap-2 items-center\">\n                    <span className={`px-1.5 py-0.5 text-[8px] font-black uppercase ${\n                      log.type === \'booking\' ? \'bg-orange-100 text-orange-800\' :\n                      log.type === \'checkin\' ? \'bg-green-100 text-green-800\' :\n                      log.type === \'dining\' ? \'bg-indigo-100 text-indigo-800\' : \'bg-stone-100 text-stone-800\'\n                    }`}>\n                      {log.type}\n                    </span>\n                    <span className=\"text-stone-800\">{log.description}</span>\n                  </div>\n                  <span className=\"text-stone-400 text-[10px] whitespace-nowrap\">{log.timestamp}</span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* Column 3: Live Service Actions (Housekeeping and Dining) */}\n        <div className=\"space-y-6\">\n          {/* Housekeeping list widget */}\n          <div className=\"bg-white p-5 border border-[#86736F]/20\">\n            <h3 className=\"font-headline-md text-base text-[#5D241A] mb-3 font-bold flex justify-between items-center select-none\">\n              <span>Live Housekeeping Requests</span>\n              <span className=\"font-mono text-[10px] bg-[#466557]/10 text-[#466557] px-2 py-0.5 font-bold uppercase\">\n                {housekeeping.filter(h => h.status === \'requested\').length} active\n              </span>\n            </h3>\n\n            {housekeeping.length === 0 ? (\n              <p className=\"text-stone-400 text-xs italic py-4 text-center select-none\">\n                No immediate housecleaning actions dispatched.\n              </p>\n            ) : (\n              <div className=\"space-y-3\">\n                {housekeeping.map((req) => (\n                  <div\n                    key={req.id}\n                    className=\"p-3 bg-[#EEEDF2]/40 border border-stone-200 text-xs flex justify-between items-center transition-all\"\n                  >\n                    <div>\n                      <div className=\"font-mono font-black text-[#5D241A] uppercase\">\n                        {req.type}\n                      </div>\n                      <span className=\"text-stone-400 font-mono text-[10px]\">\n                        Dispatched at {req.time}\n                      </span>\n                    </div>\n\n                    <button\n                      id={`btn-complete-hk-${req.id}`}\n                      onClick={() => onToggleHousekeeping(req.id)}\n                      className={`font-mono text-[10px] font-black px-2 py-1.5 border transition-all ${\n                        req.status === \'completed\'\n                          ? \'bg-[#466557]/10 text-[#466557] border-[#466557]\'\n                          : \'bg-[#7A3A2E] text-white border-[#7A3A2E] hover:bg-[#5D241A]\'\n                      }`}\n                    >\n                      {req.status === \'completed\' ? \'COMPLETED\' : \'RESOLVE\'}\n                    </button>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Dining orders live dashboard list */}\n          <div className=\"bg-white p-5 border border-[#86736F]/20\">\n            <h3 className=\"font-headline-md text-base text-[#5D241A] mb-3 font-bold flex justify-between items-center select-none\">\n              <span>Live Kitchen Order Board</span>\n              <span className=\"font-mono text-[10px] bg-[#7A3A2E]/10 text-[#7A3A2E] px-2 py-0.5 font-bold uppercase\">\n                {diningOrders.filter(d => d.status === \'ordered\').length} active\n              </span>\n            </h3>\n\n            {diningOrders.length === 0 ? (\n              <p className=\"text-stone-400 text-xs italic py-4 text-center select-none\">\n                No orders active on kitchen fires currently.\n              </p>\n            ) : (\n              <div className=\"space-y-3\">\n                {diningOrders.map((order) => (\n                  <div\n                    key={order.id}\n                    className=\"p-3 bg-[#EEEDF2]/40 border border-stone-200 text-xs flex justify-between items-center transition-all\"\n                  >\n                    <div>\n                      <div className=\"font-bold text-[#5D241A]\">\n                        {order.items.map(i => `${i.quantity}x ${i.item}`).join(\', \')}\n                      </div>\n                      <span className=\"text-stone-400 font-mono text-[10px] block\">\n                        Order Id: {order.id} \342\200\242 {order.time}\n                      </span>\n                    </div>\n\n                    <button\n                      id={`btn-complete-dining-${order.id}`}\n                      onClick={() => onToggleDining(order.id)}\n                      className={`font-mono text-[10px] font-black px-2 py-1.5 border transition-all ${\n                        order.status === \'delivered\'\n                          ? \'bg-[#466557]/10 text-[#466557] border-[#466557]\'\n                          : \'bg-[#7A3A2E] text-white border-[#7A3A2E] hover:bg-[#5D241A]\'\n                      }`}\n                    >\n                      {order.status === \'delivered\' ? \'SERVED\' : \'DELIVER\'}\n                    </button>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n"
    }
