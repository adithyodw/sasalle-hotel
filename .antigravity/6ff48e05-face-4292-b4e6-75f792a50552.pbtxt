    replacement_infos {
      original_chunk {
        target_content: "    <div className=\"bg-[#F5F1EA] text-[#0B0D10] font-sans pb-16\">\n      \n      {/* HOME PAGE TAB */}\n      {activeTab === \'home\' && (\n        <div className=\"space-y-12\">\n          {/* Sub-navigation bar inside HOME dashboard */}\n          <div className=\"flex justify-center border-b border-[#86736F]/20 bg-white/40 sticky top-16 z-30 py-2 select-none\">\n            <div className=\"flex gap-1 bg-[#EEEDF2] p-1 text-[10px] font-mono font-bold\">\n              {([\'intro\', \'dining\', \'spa\'] as const).map((sub) => {\n                const subLabels = { intro: \'JOURNEY\', dining: \'THE BRICK & IRON\', spa: \'THE SANCTUARY SPA\' };\n                return (\n                  <button\n                    key={sub}\n                    id={`sub-tab-${sub}`}\n                    onClick={() => setActiveSubTab(sub)}\n                    className={`px-3 py-1.5 transition-all uppercase ${\n                      activeSubTab === sub\n                        ? \'bg-[#7A3A2E] text-white\'\n                        : \'text-stone-600 hover:text-[#7A3A2E]\'\n                    }`}\n                  >\n                    {subLabels[sub]}\n                  </button>\n                );\n              })}\n            </div>\n          </div>"
        replacement_content: "    <div className=\"bg-[#F5F1EA] text-[#0B0D10] font-sans pb-16 relative\">\n      \n      {/* HOME PAGE TAB */}\n      {activeTab === \'home\' && (\n        <div className=\"space-y-12\">\n          {/* Sub-navigation bar inside HOME dashboard */}\n          <div className=\"flex justify-center border-b border-[#0B0D10]/10 bg-[#F5F1EA]/85 backdrop-blur-md sticky top-20 z-30 py-3 select-none\">\n            <div className=\"flex gap-2 bg-[#0B0D10]/5 p-1 text-[10px] font-mono font-bold\">\n              {([\'intro\', \'dining\', \'spa\'] as const).map((sub) => {\n                const subLabels = { intro: \'JOURNEY\', dining: \'THE BRICK & IRON\', spa: \'THE SANCTUARY SPA\' };\n                return (\n                  <button\n                    key={sub}\n                    id={`sub-tab-${sub}`}\n                    onClick={() => setActiveSubTab(sub)}\n                    className={`px-4 py-1.5 transition-all uppercase tracking-wider ${\n                      activeSubTab === sub\n                        ? \'bg-[#0B0D10] text-white font-bold\'\n                        : \'text-[#0B0D10]/60 hover:text-[#0B0D10]\'\n                    }`}\n                  >\n                    {subLabels[sub]}\n                  </button>\n                );\n              })}\n            </div>\n          </div>"
      }
